{
  "name": "@arcanalabs/ui-components",
  "version": "1.5.0",
  "description": "Arcana Labs UI Components — a typed, framework-native shadcn-style component library for Vue 3, React, Angular and Svelte.",
  "keywords": [
    "ui",
    "components",
    "shadcn",
    "vue",
    "react",
    "angular",
    "svelte",
    "design-system",
    "typescript"
  ],
  "license": "MIT",
  "author": "Arcana Labs",
  "homepage": "https://arcana-labs-org.github.io/ui-components/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcana-labs-org/ui-components.git"
  },
  "bugs": {
    "url": "https://github.com/arcana-labs-org/ui-components/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./angular": {
      "types": "./dist/angular/angular.d.ts",
      "default": "./dist/angular/angular.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "svelte": "./dist/svelte.js",
      "import": "./dist/svelte.js",
      "require": "./dist/svelte.cjs"
    },
    "./styles.css": "./dist/ui-components.css",
    "./package.json": "./package.json"
  },
  "svelte": "./dist/svelte.js",
  "scripts": {
    "dev": "vite --config docs/vite.config.ts",
    "docs:dev": "vite --config docs/vite.config.ts",
    "docs:build": "vite build --config docs/vite.config.ts",
    "build": "vite build && npm run build:angular",
    "build:angular": "ngc -p tsconfig.angular.json",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run typecheck:docs && npm test && npm run build && npm run docs:build",
    "prepublishOnly": "npm run check",
    "release:dry": "npm pack --dry-run",
    "typecheck:docs": "vue-tsc --noEmit -p tsconfig.docs.json"
  },
  "peerDependencies": {
    "@angular/common": ">=17.0.0",
    "@angular/core": ">=17.0.0",
    "@fortawesome/fontawesome-free": ">=6.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "svelte": ">=5.0.0",
    "vue": ">=3.4.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@fortawesome/fontawesome-free": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "maska": "^1.5.0",
    "moment": "^2.29.4",
    "v-money3": "^3.24.0"
  },
  "devDependencies": {
    "@angular/common": "^21.2.18",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@angular/compiler": "^21.2.18",
    "@angular/compiler-cli": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.40",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2",
    "sass": "^1.83.0",
    "svelte": "^5.56.7",
    "typescript": "^5.7.2",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.7",
    "zone.js": "^0.16.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
